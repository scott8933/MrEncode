-- MrEncode Droplet: {{PRESET_NAME}}
-- Created: {{CREATION_DATE}}
-- Drag QuickTime (.mov / .mp4) files onto this droplet to process them with the saved preset.
-- NOTE: Codec selection (H.264 / H.265 / No Recompression) is stored inside the embedded preset JSON.

use scripting additions

property presetData : "{{SETTINGS_JSON}}" -- JSON produced by the app (must include "codec": "hevc"|"h264"|"bypass")
property mrencodeBundleID : "{{BUNDLE_ID}}"
property mrencodeAppPath : "{{APP_PATH}}"
property presetName : "{{PRESET_NAME}}"

on open droppedItems
    -- NOTE: MrEncode CLI owns all user messaging (success, partial success, errors, media issues, Deadline output, etc.)
    -- This AppleScript droplet is a thin launcher: write preset JSON to temp + invoke MrEncode + log.

    -- Optional: keep filtering if you want, but do NOT show dialogs here.
    -- If nothing acceptable, we still launch MrEncode so it can show the single consolidated message.
    set inputFiles to my pathsFromDroppedItems(droppedItems)

    -- Locate MrEncode app (by bundle id)
    set mrencodePath to my findMrEncodeApp()
    if mrencodePath is missing value or mrencodePath is "" then
        display dialog "MrEncode could not be found. Please reinstall or launch MrEncode once and try again." buttons {"OK"} default button "OK" with icon caution
        return
    end if

    set mrencodeExecutable to mrencodePath & "/Contents/MacOS/MrEncode"

    -- Basic sanity check that executable exists
    try
        do shell script "/bin/test -x " & quoted form of mrencodeExecutable
    on error
        display dialog "MrEncode executable could not be launched:\n\n" & mrencodeExecutable buttons {"OK"} default button "OK" with icon caution
        return
    end try

    -- Create temporary preset file (HFS path)
    set tempFolder to (path to temporary items folder as string)
    set tempPresetFile to tempFolder & "mrencode_droplet_" & (do shell script "uuidgen") & ".json"

    set debugLogPath to "/tmp/mrencode_droplet_debug.log"

    try
        -- Write embedded preset JSON to temp file
        set fileRef to open for access file tempPresetFile with write permission
        set eof of fileRef to 0
        write presetData to fileRef
        close access fileRef

        -- Build file list for the CLI (may be empty; that's OK)
        set fileArgs to my joinQuoted(inputFiles)

        -- Build the CLI command line
        set shellCommand to quoted form of mrencodeExecutable & " --cli --preset-file " & quoted form of (POSIX path of tempPresetFile) & " --droplet-debug-log " & quoted form of debugLogPath & " {{CLI_EXTRA_ARGS}} " & fileArgs
        set execCommand to shellCommand & " 2>&1"

        -- Debug log: record the command
        my appendToLog(debugLogPath, "MrEncode Droplet: Executing:")
        my appendToLog(debugLogPath, shellCommand)

        -- Execute (blocks until complete). MrEncode CLI will show any required UI itself.
        set cliResult to do shell script execCommand

        -- Log the result (if any)
        if cliResult is not "" then
            my appendToLog(debugLogPath, "CLI Output:")
            my appendToLog(debugLogPath, cliResult)
        end if

    on error errMsg number errNum partial result partialResult
        -- Ensure file handle is closed if we errored while writing
        try
            close access file tempPresetFile
        end try

        -- Log only. Do NOT show dialogs here (MrEncode owns messaging).
        my appendToLog(debugLogPath, "CLI Failed (exit " & errNum & "): " & errMsg)
        if partialResult is not missing value then
            my appendToLog(debugLogPath, "Partial output:")
            my appendToLog(debugLogPath, partialResult as text)
        end if
    end try

    -- Always clean up temp file
    try
        do shell script "/bin/rm -f " & quoted form of (POSIX path of tempPresetFile)
    end try
end open


-- MARK: - Helpers for CLI logging & error presentation

on pathsFromDroppedItems(droppedItems)
    set outPaths to {}
    repeat with anItem in droppedItems
        try
            set end of outPaths to POSIX path of anItem
        on error
            try
                -- Fallback: if it's already a string-like value
                set end of outPaths to (anItem as text)
            end try
        end try
    end repeat
    return outPaths
end pathsFromDroppedItems


on appendToLog(logPath, message)
    try
        do shell script "/bin/echo " & quoted form of message & " >> " & quoted form of logPath
    on error
        -- ignore logging failures
    end try
end appendToLog


-- Show info dialog when droplet is double-clicked
on run
    set dialogText to "MrEncode droplet for preset:" & return & "  • " & presetName & return & return & ¬
        "Drag .mov or .mp4 files onto this app to encode them using the saved preset." & return & return & ¬
        "Codec selection (H.264 / H.265 / No Recompression) is stored in the preset."
    display dialog dialogText buttons {"OK"} default button 1 with icon note giving up after 10
end run

-- Accept .mov/.mp4, case-insensitive
on filterAcceptableFiles(droppedItems)
    set outList to {}
    repeat with anItem in droppedItems
        set p to POSIX path of anItem
        ignoring case
            if p ends with ".mov" or p ends with ".mp4" then
                set end of outList to p
            end if
        end ignoring
    end repeat
    return outList
end filterAcceptableFiles

-- Find installed MrEncode by bundle id
on findMrEncodeApp()
    if mrencodeAppPath is not "" then
        try
            set appAlias to POSIX file mrencodeAppPath as alias
            return mrencodeAppPath
        on error
            -- stored path invalid, fall back to search
        end try
    end if
    try
        set appPath to do shell script "mdfind 'kMDItemCFBundleIdentifier == \"" & mrencodeBundleID & "\"' | head -1"
        if appPath is not "" then return appPath
    end try
    error "MrEncode application not found (bundle id: " & mrencodeBundleID & ")."
end findMrEncodeApp

-- Quote every argument (POSIX paths) and join into a single string with leading spaces
on joinQuoted(posixPathList)
    set out to ""
    repeat with p in posixPathList
        set out to out & " " & quoted form of p
    end repeat
    return out
end joinQuoted
